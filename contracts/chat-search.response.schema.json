{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "error"]
    },
    "draft_items": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "multipleOf": 0.001
          },
          "unit": {
            "type": "string",
            "enum": ["g", "kg", "ml", "L", "piece", "package", "dozen"]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["client_item_id", "name", "quantity", "unit", "notes"],
        "additionalProperties": false
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total_price_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "estimated_savings_cents": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "type": "string",
              "const": "MXN"
            },
            "stores": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "retailer": {
                    "type": "string"
                  },
                  "store_name": {
                    "type": ["string", "null"]
                  },
                  "subtotal_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "client_item_id": {
                          "type": "string"
                        },
                        "listing_id": {
                          "type": "string"
                        },
                        "product_name": {
                          "type": "string"
                        },
                        "brand": {
                          "type": ["string", "null"]
                        },
                        "requested_quantity": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 100000,
                          "multipleOf": 0.001
                        },
                        "requested_unit": {
                          "type": "string",
                          "enum": [
                            "g",
                            "kg",
                            "ml",
                            "L",
                            "piece",
                            "package",
                            "dozen"
                          ]
                        },
                        "package_quantity": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 100000,
                          "multipleOf": 0.001
                        },
                        "package_unit": {
                          "type": "string",
                          "enum": [
                            "g",
                            "kg",
                            "ml",
                            "L",
                            "piece",
                            "package",
                            "dozen"
                          ]
                        },
                        "package_count": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "price_cents": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "regular_price_cents": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "line_total_cents": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "unit_price_cents_per_100": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "product_url": {
                          "type": "string",
                          "pattern": "^https?:\\/\\/"
                        },
                        "checked_at": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        },
                        "data_status": {
                          "type": "string",
                          "enum": ["verified", "stale", "demo"]
                        },
                        "match_type": {
                          "type": "string",
                          "enum": ["exact", "similar"]
                        },
                        "verified_fulfillment": {
                          "type": "string",
                          "enum": ["delivery", "pickup"]
                        },
                        "verified_postal_code": {
                          "type": "string",
                          "pattern": "^\\d{5}$"
                        }
                      },
                      "required": [
                        "client_item_id",
                        "listing_id",
                        "product_name",
                        "brand",
                        "requested_quantity",
                        "requested_unit",
                        "package_quantity",
                        "package_unit",
                        "package_count",
                        "price_cents",
                        "regular_price_cents",
                        "line_total_cents",
                        "unit_price_cents_per_100",
                        "product_url",
                        "checked_at",
                        "data_status",
                        "match_type"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "retailer",
                  "store_name",
                  "subtotal_cents",
                  "items"
                ],
                "additionalProperties": false
              }
            },
            "unmatched_items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "client_item_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "NO_MATCH",
                      "INCOMPATIBLE_UNIT",
                      "STORE_LIMIT",
                      "SOURCE_FAILED",
                      "NOTES_REQUIRE_REVIEW"
                    ]
                  }
                },
                "required": ["client_item_id", "name", "reason"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total_price_cents",
            "estimated_savings_cents",
            "currency",
            "stores",
            "unmatched_items"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "const": "published"
        },
        "data_mode": {
          "type": "string",
          "enum": ["demo", "live"]
        },
        "requested_postal_code": {
          "type": ["string", "null"]
        },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "listing": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retailer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "storeName": {
                    "type": "string"
                  },
                  "productName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "brand": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100000,
                    "multipleOf": 0.001
                  },
                  "unit": {
                    "type": "string",
                    "enum": ["g", "kg", "ml", "L", "piece", "package", "dozen"]
                  },
                  "priceCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  "regularPriceCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  "currency": {
                    "type": "string",
                    "const": "MXN"
                  },
                  "productUrl": {
                    "type": "string",
                    "pattern": "^https?:\\/\\/"
                  },
                  "imageUrl": {
                    "type": "string",
                    "pattern": "^https:\\/\\/"
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "locationEvidence": {
                    "type": "object",
                    "properties": {
                      "postalCode": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      },
                      "fulfillment": {
                        "type": "string",
                        "enum": ["delivery", "pickup"]
                      },
                      "storeName": {
                        "type": "string"
                      },
                      "availability": {
                        "type": "string",
                        "const": "in_stock"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "postalCode",
                      "fulfillment",
                      "availability",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "source",
                  "retailer",
                  "productName",
                  "priceCents",
                  "currency",
                  "productUrl",
                  "checkedAt"
                ],
                "additionalProperties": false
              },
              "unit_price_cents_per_100": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "basis": {
                "type": "string",
                "enum": ["g", "ml", "piece", "package"]
              }
            },
            "required": ["listing", "unit_price_cents_per_100", "basis"],
            "additionalProperties": false
          }
        },
        "winner_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?:\\/\\/"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query",
        "scope",
        "data_mode",
        "requested_postal_code",
        "offers",
        "winner_url"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "client_item_id": {
            "type": ["string", "null"]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": ["code", "message", "client_item_id", "retryable"],
        "additionalProperties": false
      }
    }
  },
  "required": ["reply", "status", "draft_items", "plan", "errors"],
  "additionalProperties": false
}
