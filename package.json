{
  "name": "grocery-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx backend/server.ts",
    "start": "node --env-file-if-exists=.env dist/backend/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "contracts": "node --import tsx contracts/export.ts",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "format": "prettier --write backend scrapers contracts tests scripts",
    "smoke:db": "node --env-file-if-exists=.env --import tsx scripts/database-smoke.ts",
    "smoke:scrapers": "node --env-file-if-exists=.env --import tsx scripts/scrape-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "ai": "^7.0.155",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
