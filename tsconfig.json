{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "backend/**/*.ts",
    "scrapers/**/*.ts",
    "contracts/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
