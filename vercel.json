{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel-web",
  "rewrites": [
    { "source": "/health", "destination": "https://barasu-api.onrender.com/health" },
    { "source": "/v1/:path*", "destination": "https://barasu-api.onrender.com/v1/:path*" }
  ]
}
